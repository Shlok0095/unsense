# ---- Hugging Face (primary provider — required for chat) ----
HF_TOKEN=hf_your_token_here

# Optional model overrides — sensible defaults are used if unset.
# HF_PRIMARY_MODEL=Orenguteng/Llama-3.1-8B-Lexi-Uncensored-V2:featherless-ai
# HF_DEEP_MODEL=NousResearch/Hermes-3-Llama-3.1-70B:featherless-ai
# HF_CODE_MODEL=NousResearch/Hermes-3-Llama-3.1-70B:featherless-ai
# HF_FALLBACK_MODEL=NousResearch/Hermes-3-Llama-3.1-70B:featherless-ai

# ---- NVIDIA (optional — only needed for image uploads / scanned PDFs) ----
NVIDIA_API_KEY=nvapi_your_key_here

# ---- Ollama (optional — enables "Local" privacy mode, fully offline) ----
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# ---- Context management (optional tuning) ----
# CONTEXT_TOKEN_BUDGET=6000

# ---- Local dev server ----
# PORT=3000
