{
  "name": "unsense",
  "version": "1.0.0",
  "description": "Uncensored chat app powered by Hugging Face",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --minify",
    "dev:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --watch",
    "dev": "node src/server.js",
    "start": "node src/server.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mammoth": "^1.12.1",
    "multer": "^2.2.0",
    "officeparser": "^7.8.0",
    "open": "^10.1.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
